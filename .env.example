DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api

# In produzione valorizzare per PostgreSQL:
POSTGRES_DB=english_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Solo per «manage.py importa_in_sicurezza», che crea un branch di backup su
# Neon prima di importare. Non servono per far girare il sito.
#   NEON_API_KEY    console.neon.tech → Account settings → API keys → Create
#                   (mostrata una sola volta alla creazione)
#   NEON_PROJECT_ID console.neon.tech → il progetto → Settings
NEON_API_KEY=
NEON_PROJECT_ID=
